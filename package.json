{
  "name": "@sideband/gateway",
  "version": "0.1.0",
  "description": "Sideband provider gateway: metered demo service, usage meter, anti-replay voucher validation, settlement preparation (Testnet/synthetic only).",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "fixtures": "tsx scripts/gen-fixtures.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@sideband/channels": "file:../Sideband-channels",
    "@stellar/stellar-sdk": "^17.4.0",
    "zod": "^4.6.7"
  }
}
