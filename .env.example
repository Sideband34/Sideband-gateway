# NON-SECRET CONFIG ONLY — placeholder values, do not use production keys
APP_ENV=development
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
DATABASE_URL=postgresql://localhost:5432/app_dev
PUBLIC_API_URL=http://localhost:3001
# gateway (all optional, non-secret)
PORT=3001
HOST=127.0.0.1
DB_PATH=:memory:
PRICE_PER_UNIT=0.001
MAX_SESSION_UNITS=1000
CREDIT_ALLOWANCE=0
# settle = withdraw and keep the channel open (long-running provider); close = terminal
SETTLE_MODE=settle
# Auto-settle once unsettled value reaches this amount (0 = off); also answers a
# payer close_start with the highest voucher inside the dispute window.
AUTO_SETTLE_AMOUNT=0
AUTO_SETTLE_INTERVAL_SEC=60
# DEV_PAYER_PUBLIC_KEY=G...   # opens ONE synthetic channel in the in-memory test adapter
SESSION_SECRET=change-me-to-a-long-random-string
# ADMIN_TOKEN=   # unset => settle/status endpoints disabled
RATE_LIMIT_BURST=60
RATE_LIMIT_PER_SEC=20
# --- Real Testnet channel (verified live, see docs/DEPLOYMENT.md) ---
# ADAPTER=soroban
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org   # NOTE: this name (not STELLAR_RPC_URL) is what the gateway reads
# CHANNEL_WASM_HASH=<hex sha256 of the uploaded channel wasm, from Sideband-channels/.testnet-channel.env>
# PROVIDER_SECRET=<Testnet provider secret; put it only in your own untracked .env or a secret manager, never commit>
# DB_PATH=./data/gateway.db   # persistent vouchers, nonces, sessions AND settlement intents (the directory is created)
# WARNING: stellar-cli also loads a .env from its working directory, and SOROBAN_RPC_URL there makes it demand
# --network-passphrase. Run stellar-cli from another directory (the live scripts do).
# The payer opens/tops up channels with its own key; the gateway only ever signs as the provider (settle/close).
